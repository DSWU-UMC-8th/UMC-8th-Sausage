{
  "swagger": "2.0",
  "info": {
    "title": "UMC 8th",
    "description": "UMC 테스트 프로젝트입니다.",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/api/user/{userId}": {
      "get": {
        "summary": "유저 리뷰 조회",
        "description": "",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "유저의 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "유저 리뷰 목록 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "number",
                        "example": 1
                      },
                      "title": {
                        "type": "string",
                        "example": "미션 제목"
                      },
                      "reward": {
                        "type": "number",
                        "example": 500
                      },
                      "status": {
                        "type": "string",
                        "example": "성공"
                      },
                      "content": {
                        "type": "string",
                        "example": "리뷰 내용"
                      },
                      "rating": {
                        "type": "number",
                        "example": 4.5
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/complete/{missionId}": {
      "put": {
        "summary": "미션 완료 처리",
        "description": "",
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "미션의 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "미션 완료 처리 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "미션 완료"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/store/{storeId}": {
      "get": {
        "summary": "가게 미션 조회",
        "description": "",
        "parameters": [
          {
            "name": "storeId",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "가게의 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "가게 미션 목록 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "number",
                        "example": 2
                      },
                      "title": {
                        "type": "string",
                        "example": "가게 미션"
                      },
                      "reward": {
                        "type": "number",
                        "example": 300
                      },
                      "status": {
                        "type": "string",
                        "example": "진행 중"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}